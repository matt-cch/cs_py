{
  "$schema": "https://raw.githubusercontent.com/matt-cch/cs_py/main/references/tasks/deploy-git-isolated/scripts/lib-plugins/github-api.schema.json",
  "meta": {
    "description": "github-sync-issue 脚本的行为配置真源。高频变动内容（模板、labels）从此读取，脚本本身只负责框架逻辑。",
    "version": "1.0.0",
    "updated": "2026-06-17"
  },
  "defaults": {
    "owner": "matt-cch",
    "repo": "cs_py",
    "api_base": "https://api.github.com"
  },
  "issue_templates": {
    "task-tracking": {
      "title": "[Task Tracking] {task_name} 变更历史",
      "labels": ["task-active"],
      "body_header": "## 初始提交\n\n| 属性 | 值 |\n|------|-----|",
      "body_footer": "\n\n---\n\n> 本 Issue 用于追踪 `{task_name}` 任务的后续变更。\n> 每次新的 commit/PR 关联到本任务时，请在下方追加评论记录。\n> 任务完成时，添加 label `task-completed` 并关闭本 Issue。"
    }
  },
  "comment_templates": {
    "commit-sync": {
      "header": "## 变更记录 — {timestamp}",
      "row": "| `{commit_hash}` | `{branch}` | {commit_msg} | {date} |"
    }
  },
  "modes": {
    "create": { "method": "POST", "endpoint": "/repos/{owner}/{repo}/issues" },
    "update": { "method": "PATCH", "endpoint": "/repos/{owner}/{repo}/issues/{number}" },
    "comment": { "method": "POST", "endpoint": "/repos/{owner}/{repo}/issues/{number}/comments" },
    "list-comments": { "method": "GET", "endpoint": "/repos/{owner}/{repo}/issues/{number}/comments" },
    "get-issue": { "method": "GET", "endpoint": "/repos/{owner}/{repo}/issues/{number}" }
  }
}
